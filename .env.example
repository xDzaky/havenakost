# ---------------------------------------------------------------------------
# Havena Kost — contoh environment variables
# Salin menjadi .env lalu isi nilainya. JANGAN commit file .env.
# ---------------------------------------------------------------------------

# Neon PostgreSQL (gunakan endpoint pooler bila tersedia)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Database terpisah untuk test. Jangan memakai database produksi.
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST/havenakost_test?sslmode=require"

# Better Auth
# Buat dengan: openssl rand -base64 32
BETTER_AUTH_SECRET="GANTI_DENGAN_SECRET_ACAK_MINIMAL_32_KARAKTER"
BETTER_AUTH_URL="http://localhost:3000"
APP_BASE_URL="http://localhost:3000"

# Cloudflare R2 (S3-compatible API)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
# Kosongkan bila bucket privat. Foto akan disajikan melalui proxy backend.
R2_PUBLIC_URL=""

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# HMAC untuk fingerprint rate limit (jangan menyimpan IP mentah)
# Buat dengan: openssl rand -hex 32
REVIEW_RATE_LIMIT_HMAC_SECRET=""

# Layanan Email (Resend) - Wajib untuk reset password dan verifikasi email di produksi
RESEND_API_KEY=""
EMAIL_FROM="Havena Kost <noreply@havenakost.com>"

# Hanya dipakai script bootstrap admin, bukan untuk runtime API
ADMIN_BOOTSTRAP_EMAIL=""
ADMIN_BOOTSTRAP_PASSWORD=""
ADMIN_BOOTSTRAP_NAME="Havena Admin"
